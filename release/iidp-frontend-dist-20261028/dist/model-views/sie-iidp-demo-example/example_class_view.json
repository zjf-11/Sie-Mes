{
  "views": {
    "demo_example_class_grid_search": {
      "mode": "primary",
      "name": "Example-班级-搜索",
      "model": "example_class",
      "type": "search",
      "body": {
        "columns": [
          "className"
        ],
        "type": "search"
      }
    },
    "demo_example_class_grid": {
      "body": {
        "checkbox": "multiple_2",
        "typeView": "subTable",
        "buttons": [
          {
            "action": "preview",
            "auth": "read",
            "name": "详情"
          },
          {
            "action": "edit",
            "auth": "update",
            "name": "编辑"
          }
        ],
        "headerSortRemote": true,
        "sortMultiple": true,
        "gridEditMode": {
          "mode": "multipleRow",
          "rowBtns": [
            "update",
            "add"
          ],
          "defaultCancelEdit": true
        },
        "beforeEditMethod": "({ row, column, rowIndex, columnIndex }) => {\n          // 该方法每个可编辑的单元格点击前都会触发，可根据row和column的数据判断是否可编辑\n          // 下方的逻辑为 「班级编码」值为'111'的行,「班级名称」不允许编辑\n          let filed = column?.field;\n          switch (filed) {\n            case 'classCode':\n              return true;\n            case 'className':\n              if (row.classCode === '111') {\n                return false;\n              }\n              return true;\n            default:\n              return true;\n          }\n        }",
        "columns": [
          {
            "displayName": "班级编码",
            "name": "classCode",
            "custom": true,
            "rowEditable": true
          },
          {
            "displayName": "班级名称(级联选择器案例)",
            "name": "className",
            "custom": true,
            "rowEditable": true,
            "editConfigs": {
              "editType": "cascader",
              "options": []
            }
          },
          {
            "displayName": "创建人",
            "name": "create_user",
            "custom": true,
            "rowEditable": true
          },
          {
            "displayName": "创建时间",
            "name": "create_date",
            "custom": true
          },
          {
            "displayName": "更新人",
            "name": "update_user",
            "custom": true
          },
          {
            "displayName": "更新时间",
            "name": "update_date",
            "custom": true
          }
        ],
        "tbar": [
          {
            "action": "create",
            "auth": "create",
            "name": "新增"
          },
          {
            "action": "delete",
            "auth": "delete",
            "name": "删除"
          }
        ],
        "type": "grid"
      },
      "mode": "primary",
      "model": "example_class",
      "name": "Example-班级-列表",
      "type": "grid"
    },
    "demo_example_class_grid_param_form": {
      "mode": "primary",
      "name": "Example-班级-表单",
      "model": "example_class",
      "type": "form",
      "body": {
        "buttons": [
          "@defaults"
        ],
        "columns": [
          {
            "displayName": "班级编码",
            "name": "classCode",
            "custom": true
          },
          {
            "displayName": "班级名称",
            "name": "className",
            "custom": true
          }
        ],
        "tbar": [
          "@defaults"
        ],
        "type": "form",
        "tabs": [
          {
            "header": "学生",
            "isAloneSave": true,
            "tbar": [
              {
                "name": "添加",
                "action": "addEr",
                "auth": "update"
              },
              {
                "name": "删除",
                "action": "deleteEr",
                "auth": "deleteEr"
              },
              {
                "action": "xxx",
                "service": "xxx",
                "auth": "xxx",
                "name": "自定义操作",
                "model": "xxxxxx"
              }
            ],
            "body": {
              "model": "example_student",
              "type": "demo_example_student_grid,demo_example_student_grid_search",
              "field": "studentList",
              "buttons": [
                {
                  "action": "preview",
                  "auth": "read",
                  "name": "详情"
                },
                {
                  "name": "编辑",
                  "action": "updateEr",
                  "auth": "update",
                  "enableCondition": "(row) => {return row[0].isEnable !== true;}"
                }
              ],
              "pagin": {
                "limit": 0,
                "display": false,
                "unPaging": true
              },
              "columns": [
                {
                  "displayName": "学生名称",
                  "name": "name"
                }
              ]
            }
          }
        ]
      }
    }
  }
}